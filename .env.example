# Copy to .env and fill in. Required:
GEMINI_API_KEY=your_gemini_api_key_here
ADMIN_PASSWORD=choose_a_strong_password
SESSION_SECRET=any_long_random_string

# Optional — enables the Sarvam AI voice stack (Saarika STT + Bulbul TTS).
# Get a key at https://dashboard.sarvam.ai. Without it the app falls back to
# the browser's built-in Web Speech recognition and voices.
SARVAM_API_KEY=

# Optional overrides for the Sarvam models/voice (defaults shown). If the
# configured model or speaker is rejected by the API, the server automatically
# retries and pins the stable bulbul:v2/anushka + saarika:v2 pair.
# Speaker rosters differ per Bulbul version — bulbul:v3 voices include priya,
# neha, shreya, ritu, roopa, kavya, aditya, rahul...; bulbul:v2 uses anushka,
# manisha, vidya, arya, ...
# SARVAM_STT_MODEL=saarika:v2.5
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=priya
